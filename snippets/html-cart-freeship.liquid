{%- comment -%}
============================================================================
HTML-CART-FREESHIP
============================================================================
Renders the free-shipping progress bar as a native <details> accordion.
Pure executor — receives everything via parameters, no schema. Reusable
anywhere (cart section now, cart-preview drawer later).

PARAMS:
- threshold      : {Number} Free-shipping threshold in WHOLE currency units
                   for the active currency (0/blank → renders nothing).
- basis          : {String} 'total' | 'subtotal' (default 'total')
- remaining_text : {String} Message with {amount} placeholder
- reached_text   : {String} Message shown once the threshold is reached
- explaining     : {richtext} Optional body; when blank there is no toggle
                   (plain bar instead of an accordion)
- show_when_empty: {Boolean} Keep visible on an empty cart (default false)

Colors/padding are driven by CSS custom properties set by the host section
(--cart-freeship-card / --cart-freeship-fill / --cart-freeship-track /
--cart-freeship-reached); the snippet falls back to sensible defaults.

DEPENDENCIES: window.CartEvents (theme-cart.js), block-cart-freeship.min.js
============================================================================
{%- endcomment -%}

{%- liquid
  assign threshold = threshold | default: 0
  assign basis = basis | default: 'total'
  assign remaining_text = remaining_text | default: 'Nog {amount} te gaan voor gratis verzending'
  assign reached_text = reached_text | default: 'Je komt in aanmerking voor gratis verzending'
  assign show_when_empty = show_when_empty | default: false

  assign has_explain = false
  if explaining != blank
    assign has_explain = true
  endif
-%}

{%- if threshold > 0 -%}
  {{ 'block-cart-freeship.min.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign threshold_cents = threshold | times: 100

    if basis == 'subtotal'
      assign basis_cents = cart.items_subtotal_price
    else
      assign basis_cents = cart.total_price
    endif

    assign remaining_cents = threshold_cents | minus: basis_cents
    assign reached = false
    if remaining_cents <= 0
      assign reached = true
    endif

    assign percent = 0
    if threshold_cents > 0
      assign percent = basis_cents | times: 100 | divided_by: threshold_cents
    endif
    if percent > 100
      assign percent = 100
    endif

    comment
      Currency formatting primitives (mirrors block-search-overlay)
    endcomment
    assign currency_symbol = cart.currency.symbol | default: localization.country.currency.symbol | default: '€'
    assign money_probe = 199999 | money_without_currency
    assign dec_sep = money_probe | slice: -3, 1
    assign thou_sep = money_probe | slice: 1, 1
    if dec_sep == '0' or dec_sep == '9'
      assign dec_sep = ','
    endif
    if thou_sep == '9'
      assign thou_sep = ''
    endif

    assign rem_abs = remaining_cents
    if rem_abs < 0
      assign rem_abs = 0
    endif
    assign rem_str = rem_abs | money_without_currency
    assign rem_parts = rem_str | split: dec_sep
    assign rem_before = rem_parts[0]
    assign rem_after = rem_parts[1] | default: '00'
  -%}

  {%- comment -%} Placeholder + amount markup — {amount} never inside a {{ }} tag (strict parser) {%- endcomment -%}
  {%- capture ph -%}{amount}{%- endcapture -%}
  {%- capture amount_html -%}<span class="price"><span class="valuta">{{ currency_symbol }}</span><span class="before_seperator">{{ rem_before }}</span>{% if settings.price_hide_zero_cents and rem_after == '00' %}{% else %}<span class="seperator">{{ dec_sep }}</span><span class="after_seperator">{{ rem_after }}</span>{% endif %}</span>{%- endcapture -%}
  {%- assign remaining_message = remaining_text | replace: ph, amount_html -%}

  {%- capture cf_config -%}
    <script type="application/json" data-freeship-config>
      {
        "threshold": {{ threshold_cents | json }},
        "basis": {{ basis | json }},
        "showWhenEmpty": {{ show_when_empty | json }},
        "currency": {
          "symbol": {{ currency_symbol | json }},
          "code": {{ cart.currency.iso_code | json }},
          "decimalSeparator": {{ dec_sep | json }},
          "thousandsSeparator": {{ thou_sep | json }}
        },
        "hideZeroCents": {{ settings.price_hide_zero_cents | default: false | json }},
        "texts": {
          "remaining": {{ remaining_text | json }},
          "reached": {{ reached_text | json }}
        }
      }
    </script>
  {%- endcapture -%}

  {%- capture cf_head -%}
    <div class="cart-freeship__top">
      <p class="cart-freeship__msg" data-freeship-message>{% if reached %}{{ reached_text }}{% else %}{{ remaining_message }}{% endif %}</p>
      {%- if has_explain -%}
        <svg class="cart-freeship__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
      {%- endif -%}
    </div>
    <div class="cart-freeship__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}">
      <div class="cart-freeship__fill" data-freeship-fill style="width: {{ percent }}%;"></div>
    </div>
  {%- endcapture -%}

  {%- if has_explain -%}
    <details class="cart-freeship{% if reached %} cart-freeship--reached{% endif %}" data-cart-freeship>
      <summary class="cart-freeship__header">{{ cf_head }}</summary>
      <div class="cart-freeship__body">
        <div class="cart-freeship__explain">{{ explaining }}</div>
      </div>
      {{ cf_config }}
    </details>
  {%- else -%}
    <div class="cart-freeship{% if reached %} cart-freeship--reached{% endif %}" data-cart-freeship>
      <div class="cart-freeship__header">{{ cf_head }}</div>
      {{ cf_config }}
    </div>
  {%- endif -%}

  <script src="{{ 'block-cart-freeship.min.js' | asset_url }}" defer></script>
{%- endif -%}
