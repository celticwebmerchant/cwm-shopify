{% doc %}
  @prompt
    Maak een sectie waarbij je producten kan toevoegen aan een carrousel, maar deze producten zelf handig kan selecteren. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 20px;
  }

  .ai-product-carousel-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
    padding: 0 20px;
  }

  .ai-product-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
  }

  .ai-product-carousel-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-product-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .ai-product-carousel-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.products_per_row | minus: 1 }} * {{ block.settings.product_gap }}px)) / {{ block.settings.products_per_row }});
    min-width: 0;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 150%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }
{{ article.metafields.custom.blogproducten | json }}

  .ai-product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-title-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    margin-top: auto;
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-carousel-button-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, opacity 0.3s ease;
  }

  .ai-carousel-button-{{ ai_gen_id }}:hover:not(:disabled) {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-carousel-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-carousel-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.nav_button_icon_color }};
  }

  .ai-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    transition: opacity 0.3s ease;
    cursor: pointer;
    border: none;
    padding: 0;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-product-carousel-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.product_gap }}px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-carousel-item-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-product-carousel-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-product-carousel-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }}
  class="ai-product-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-products-per-row="{{ block.settings.products_per_row }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-product-carousel-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-product-carousel-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <div class="ai-product-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
    </div>
  {% endif %}

{% assign selected_products = article.metafields.custom.blogproducten.value %}
  {% if selected_products == blank %}
    {% assign selected_products = block.settings.products %}
  {% endif %}
  {% assign product_count = selected_products | size %}

  {% if product_count > 0 %}
    <div class="ai-product-carousel-container-{{ ai_gen_id }}">
      <div class="ai-product-carousel-track-{{ ai_gen_id }}" data-carousel-track>
        {% for product in selected_products %}
          <div class="ai-product-carousel-item-{{ ai_gen_id }}">
            <div class="ai-product-card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600, height: 900, crop: 'center' }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="900"
                  >
                {% else %}
                  <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>
              <div class="ai-product-info-{{ ai_gen_id }}">
                <h3 class="ai-product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <div class="ai-product-price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-product-price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span>{{ product.price | money }}</span>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_navigation and product_count > block.settings.products_per_row %}
      <div class="ai-carousel-nav-{{ ai_gen_id }}">
        <button
          class="ai-carousel-button-{{ ai_gen_id }}"
          data-carousel-prev
          aria-label="Vorige producten"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="ai-carousel-dots-{{ ai_gen_id }}" data-carousel-dots></div>

        <button
          class="ai-carousel-button-{{ ai_gen_id }}"
          data-carousel-next
          aria-label="Volgende producten"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    {% endif %}
  {% else %}
    <div class="ai-empty-state-{{ ai_gen_id }}">
      {{ 'product-1' | placeholder_svg_tag }}
      <p>Selecteer producten om in de carrousel te tonen</p>
    </div>
  {% endif %}
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');
        this.dotsContainer = this.querySelector('[data-carousel-dots]');
        
        if (!this.track) return;

        this.items = Array.from(this.track.children);
        this.productsPerRow = parseInt(this.dataset.productsPerRow) || 4;
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5;

        this.updateProductsPerRow();
        this.totalPages = Math.ceil(this.items.length / this.productsPerRow);

        if (this.totalPages > 1) {
          this.createDots();
          this.setupEventListeners();
          
          if (this.autoplay) {
            this.startAutoplay();
            this.addEventListener('mouseenter', () => this.stopAutoplay());
            this.addEventListener('mouseleave', () => this.startAutoplay());
          }
        }

        this.updateCarousel();

        window.addEventListener('resize', () => {
          this.updateProductsPerRow();
          this.totalPages = Math.ceil(this.items.length / this.productsPerRow);
          this.currentIndex = Math.min(this.currentIndex, this.totalPages - 1);
          this.createDots();
          this.updateCarousel();
        });
      }

      updateProductsPerRow() {
        if (window.innerWidth <= 749) {
          this.productsPerRow = 1;
        } else if (window.innerWidth <= 989) {
          this.productsPerRow = 2;
        } else {
          this.productsPerRow = parseInt(this.dataset.productsPerRow) || 4;
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        
        for (let i = 0; i < this.totalPages; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-carousel-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Ga naar pagina ${i + 1}`);
          dot.addEventListener('click', () => this.goToPage(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      prev() {
        this.currentIndex = this.currentIndex > 0 ? this.currentIndex - 1 : this.totalPages - 1;
        this.updateCarousel();
      }

      next() {
        this.currentIndex = this.currentIndex < this.totalPages - 1 ? this.currentIndex + 1 : 0;
        this.updateCarousel();
      }

      goToPage(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        if (!this.track) return;

        const itemWidth = this.items[0]?.offsetWidth || 0;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const offset = -(this.currentIndex * this.productsPerRow * (itemWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.totalPages - 1;
        }

        if (this.dotsContainer) {
          const dots = this.dotsContainer.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
          dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === this.currentIndex);
          });
        }
      }

      startAutoplay() {
        if (!this.autoplay || this.totalPages <= 1) return;
        
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, this.autoplaySpeed * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product carrousel",
  "settings": [
    {
      "type": "header",
      "content": "Producten"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Producten (fallback)",
      "limit": 20
    },
    {
      "type": "header",
      "content": "Koppen"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titel",
      "default": "Onze collectie"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Ondertitel"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Uitlijning",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Midden" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Titelgrootte",
      "min": 16, "max": 48, "step": 2, "unit": "px", "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Ondertitelgrootte",
      "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Producten per rij (desktop)",
      "min": 2, "max": 6, "step": 1, "default": 4
    },
    {
      "type": "range",
      "id": "product_gap",
      "label": "Ruimte tussen producten",
      "min": 10, "max": 40, "step": 5, "unit": "px", "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Sectie padding",
      "min": 0, "max": 100, "step": 10, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop breedte",
      "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "header",
      "content": "Navigatie"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Toon navigatie",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Automatisch afspelen",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Afspeelsnelheid",
      "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5
    },
    {
      "type": "range",
      "id": "nav_button_size",
      "label": "Knopgrootte",
      "min": 30, "max": 60, "step": 5, "unit": "px", "default": 40
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Achtergrond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Titel",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Ondertitel",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Productkaart achtergrond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Producttitel",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Productprijs",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "nav_button_color",
      "label": "Navigatieknop",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "nav_button_hover_color",
      "label": "Navigatieknop hover",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "nav_button_icon_color",
      "label": "Navigatie icoon",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Navigatiepunten",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Stijl"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Kaart afronding",
      "min": 0, "max": 20, "step": 2, "unit": "px", "default": 8
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Producttitel grootte",
      "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16
    },
    {
      "type": "range",
      "id": "product_price_size",
      "label": "Productprijs grootte",
      "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product carrousel"
    }
  ]
}
{% endschema %}
